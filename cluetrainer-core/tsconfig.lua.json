{
  "compilerOptions": {
    "target": "ES2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "outDir": "dist-lua",
    "rootDir": "src",
    "skipLibCheck": true,
    "declarationDir": "dist",
    "declaration": true,
    "strict": false
  },
  "include": ["src/**/*.ts"],
  "exclude": ["dist", "node_modules"],
  "tstl": {
    "luaTarget": "5.4",
    "buildMode": "library"
  }
}